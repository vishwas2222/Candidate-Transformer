{
    "profile": "analytics",
    "include_fields": [
        "full_name",
        "emails",
        "phones",
        "headline",
        "current_company",
        "title",
        "skills",
        "experience",
        "education",
        "projects"
    ],
    "exclude_fields": [],
    "include_confidence": true,
    "include_sources": true,
    "pretty_print": true,
    "sort_skills": true,
    "sort_projects": true,
    "date_format": "ISO",
    "output_directory": "output",
    "output_filename": "candidate.json",
    "empty_field_policy": "keep",
    "field_mapping": {},
    "metadata": {
        "include": true,
        "schema_version": "1.0"
    },
    "validation": {
        "enabled": true,
        "strict": false
    }
}
